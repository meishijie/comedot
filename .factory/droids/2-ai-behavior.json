  "patterns": {
    "files": ["**/*Turret*.gd", "**/*Chase*.gd", "**/*Navigation*.gd", "**/*Agent*.gd"],
    "code": ["updateTarget", "rotateTowardsTarget", "predictTargetPosition", "tryToShoot"]
  },
  "codingConventions": {
    "naming": "camelCase",
    "noUnderscores": true,
    "tabWidth": 2
  },
  "todoFocus": ["Turret AI 完善", "目标预测算法", "AI 组件与 InputComponent 解耦"]
}
